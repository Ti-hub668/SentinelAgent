# =========================
# Database
# =========================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=sentinelagent


# =========================
# External Tool Execution
# =========================

# Keep false for normal development.
# Real external side effects require explicit opt-in.
SENTINEL_EXTERNAL_TOOL_EXECUTION_ENABLED=false


# =========================
# GitHub Ticket Adapter
# =========================

SENTINEL_GITHUB_TICKET_ENABLED=false
SENTINEL_GITHUB_API_URL=https://api.github.com
SENTINEL_GITHUB_OWNER=your_github_username
SENTINEL_GITHUB_REPO=sentinelagent-integration-test
SENTINEL_GITHUB_TOKEN=
SENTINEL_GITHUB_TIMEOUT_SECONDS=10


# =========================
# Execution Recovery
# =========================

SENTINEL_EXECUTION_CLAIM_STALE_SECONDS=60